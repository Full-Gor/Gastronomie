rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règles pour la collection des plats du menu
    match /menu/{document} {
      // Tout le monde peut lire
      allow read: if true;
      // Seuls les utilisateurs authentifiés peuvent écrire
      allow write: if request.auth != null;
    }

    // Règles pour la collection des pages
    match /pages/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Règles pour la collection des services
    match /services/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Règles pour la collection à propos
    match /apropos/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Règles pour les paramètres du site
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
